# Copy to .env and set a private key. Every backend startup reads this file directly.
# APP_LOGIN_KEY in .env is authoritative; shell overrides are ignored for this key.
APP_LOGIN_KEY=replace-with-a-long-random-key
HTTP_ADDR=127.0.0.1:9001
SESSION_TTL=8h
# Per provider HTTP request, not the whole scan.
REQUEST_TIMEOUT=30s
# Set after npm run build to serve the React UI from Go.
# WEB_DIST_DIR=web/dist

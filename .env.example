# Cloud URL is the current app origin. Only this key is entered in the login UI.
APP_LOGIN_KEY=replace-with-a-long-random-key
HTTP_ADDR=127.0.0.1:9001
SESSION_TTL=24h
# Per provider HTTP request, not the whole scan.
REQUEST_TIMEOUT=30s
# Set after npm run build to serve the React UI from Go.
# WEB_DIST_DIR=web/dist
# Optional Fingerpoint SDK settings. The first detection downloads and caches
# reference data automatically; leave unset to use official default sources/cache.
# FINGERPRINT_DATA_SOURCE=https://lm.ikale.io/data/
# FINGERPRINT_CACHE_PATH=/custom/cache/path/lmfpd-data.bin
FINGERPRINT_REQUEST_TIMEOUT=120s

# Persistent inspection project settings, encrypted credentials and batch history.
DATA_DIR=data

# Optional pinned Harbor runtime (install: make terminal-bench-install).
TERMINAL_BENCH_BINARY=extensions/terminal-bench/.venv/bin/harbor

# Server-side data owner for key login; not an input in the login UI.
# The password below is used only when initializing the first SQLite account.
CLOUD_ADMIN_USERNAME=admin
CLOUD_ADMIN_PASSWORD=replace-with-a-long-random-password
